# sigma-verify environment variables. All are optional: providers without
# credentials are reported as unavailable and skipped. Placeholder values only.
#
# With `claude mcp add`, pass these as `-e NAME=value`; the server does not
# read a .env file on its own.

# --- Per-token API providers ---

# OpenAI (provider: openai)
OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-5.4
# OPENAI_REASONING_MODEL=gpt-5.4-pro

# Google Gemini (provider: google)
GOOGLE_AI_API_KEY=your-google-ai-key
# GOOGLE_AI_MODEL=gemini-3.1-pro-preview

# Anthropic (provider: anthropic) — excluded from default selections; used only
# when named explicitly (provider="anthropic") or when opted in below.
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# ANTHROPIC_MODEL=claude-opus-5-5
# SIGMA_VERIFY_ALLOW_ANTHROPIC=1

# --- Ollama-backed providers ---
# No key needed: they talk to a local Ollama server (default
# http://localhost:11434). Local models need `ollama pull <model>`; cloud
# models need `ollama signin` (paid ones also need credits).
#
# Every Ollama-backed provider accepts the same overrides, using its prefix:
#   <PREFIX>_MODEL     model name
#   <PREFIX>_BASE_URL  OpenAI-compatible endpoint (default http://localhost:11434/v1)
#   <PREFIX>_PROVIDER  preset: "ollama" (default) or "openrouter" where supported
#   <PREFIX>_API_KEY   explicit key (overrides the preset's key)
#
# Opt-in: let init / server startup run `ollama serve` when Ollama is installed
# but not running. Off by default.
# SIGMA_VERIFY_AUTOSTART_OLLAMA=1
#
# Prefixes:
#   LLAMA          llama          local   llama3.1:8b                (openrouter supported)
#   GEMMA          gemma          local   gemma4:e4b                 (openrouter supported)
#   NEMOTRON_NANO  nemotron-nano  local   nemotron-3-nano:4b
#   QWEN_LOCAL     qwen-local     local   qwen3.5:4b
#   GPT_OSS        gpt-oss        cloud   gpt-oss:120b-cloud         (openrouter supported)
#   NEMOTRON       nemotron       cloud   nemotron-3-super:cloud     (openrouter supported)
#   DEEPSEEK       deepseek       cloud   deepseek-v4.1-flash:cloud
#   MISTRAL        mistral        cloud   mistral-large-3:675b-cloud
#   GLM            glm            cloud   glm-5.3:cloud
#   KIMI           kimi           cloud   kimi-k3:cloud
#
# Examples:
# LLAMA_MODEL=llama3.3:70b
# GEMMA_BASE_URL=http://other-host:11434/v1
# GPT_OSS_PROVIDER=openrouter

# OpenRouter key, used by any provider whose <PREFIX>_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-your-openrouter-key
